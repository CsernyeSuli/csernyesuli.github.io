<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hatványozás Kvíz - 7. Osztály</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f9;
            color: #333;
            line-height: 1.6;
            margin: 0;
            padding: 20px;
        }
        .quiz-container {
            max-width: 700px;
            margin: 30px auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }
        h1 {
            color: #2c3e50;
            text-align: center;
            border-bottom: 3px solid #ff9800;
            padding-bottom: 10px;
        }
        .question {
            margin-bottom: 25px;
            padding: 15px;
            border-radius: 8px;
            background-color: #f9f9f9;
        }
        .question p {
            font-weight: bold;
            margin-top: 0;
            color: #2c3e50;
        }
        .options label {
            display: block;
            margin: 10px 0;
            padding: 10px;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .options label:hover {
            background: #eef5fc;
        }
        .options input {
            margin-right: 10px;
        }
        .btn-submit {
            display: block;
            width: 100%;
            background: #27ae60;
            color: white;
            border: none;
            padding: 15px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 8px;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: background 0.2s;
        }
        .btn-submit:hover {
            background: #219653;
        }
        #result {
            margin-top: 20px;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            font-size: 20px;
            font-weight: bold;
            display: none;
        }
        .correct-answer {
            background-color: #d4edda !important;
            border-color: #c3e6cb !important;
            color: #155724;
        }
        .wrong-answer {
            background-color: #f8d7da !important;
            border-color: #f5c6cb !important;
            color: #721c24;
        }
    </style>
</head>
<body>

<div class="quiz-container">
    <h1>Kvíz: A Hatványozás Alapjai</h1>
    <form id="quizForm">
        
        <!-- Q1 -->
        <div class="question" id="q1-box">
            <p>1. Mi a hatvány lényege?</p>
            <div class="options">
                <label><input type="radio" name="q1" value="A"> Ismételt összeadás</label>
                <label><input type="radio" name="q1" value="B"> Ismételt szorzás</label>
                <label><input type="radio" name="q1" value="C"> Számok négyzetgyöke</label>
            </div>
        </div>

        <!-- Q2 -->
        <div class="question" id="q2-box">
            <p>2. Mit mutat meg a hatvány kitevője?</p>
            <div class="options">
                <label><input type="radio" name="q2" value="A"> Azt a számot, amit önmagával szorzunk</label>
                <label><input type="radio" name="q2" value="B"> A szorzat végeredményét</label>
                <label><input type="radio" name="q2" value="C"> A darabszámot, hogy hány tényező van a szorzásban</label>
            </div>
        </div>

        <!-- Q3 -->
        <div class="question" id="q3-box">
            <p>3. Mennyi egy tetszőleges szám (kivéve a 0) a 0. hatványon?</p>
            <div class="options">
                <label><input type="radio" name="q3" value="A"> 0</label>
                <label><input type="radio" name="q3" value="B"> 1</label>
                <label><input type="radio" name="q3" value="C"> Önmagával egyenlő</label>
            </div>
        </div>

        <!-- Q4 -->
        <div class="question" id="q4-box">
            <p>4. Milyen előjelű lesz egy negatív szám páros kitevőjű hatványa?</p>
            <div class="options">
                <label><input type="radio" name="q4" value="A"> Mindig pozitív</label>
                <label><input type="radio" name="q4" value="B"> Mindig negatív</label>
                <label><input type="radio" name="q4" value="C"> Nulla lesz</label>
            </div>
        </div>

        <!-- Q5 -->
        <div class="question" id="q5-box">
            <p>5. Mi a szabály azonos alapú hatványok szorzásakor?</p>
            <div class="options">
                <label><input type="radio" name="q5" value="A"> A közös alapot a kitevők szorzatára emeljük</label>
                <label><input type="radio" name="q5" value="B"> A közös alapot a kitevők összegére emeljük</label>
                <label><input type="radio" name="q5" value="C"> Az alapokat összeszorozzuk, a kitevő változatlan</label>
            </div>
        </div>

        <!-- Q6 -->
        <div class="question" id="q6-box">
            <p>6. Hogyan végezzük el egy hatvány hatványozását?</p>
            <div class="options">
                <label><input type="radio" name="q6" value="A"> A hatvány alapot a kitevők szorzatára emeljük</label>
                <label><input type="radio" name="q6" value="B"> A hatvány alapot a kitevők összegére emeljük</label>
                <label><input type="radio" name="q6" value="C"> Kivonjuk egymásból a kitevőket</label>
            </div>
        </div>

        <button type="button" class="btn-submit" onclick="checkAnswers()">Megoldások ellenőrzése</button>
    </form>

    <div id="result"></div>
</div>

<script>
    function checkAnswers() {
        // Helyes válaszok kulcsa
        const answers = { q1: "B", q2: "C", q3: "B", q4: "A", q5: "B", q6: "A" };
        let score = 0;
        const total = Object.keys(answers).length;
        
        // Resetelni a korábbi stílusokat
        for (let i = 1; i <= total; i++) {
            const box = document.getElementById(`q${i}-box`);
            box.classList.remove('correct-answer', 'wrong-answer');
        }

        // Ellenőrzés
        for (let key in answers) {
            const selected = document.querySelector(`input[name="${key}"]:checked`);
            const box = document.getElementById(`${key}-box`);
            
            if (selected && selected.value === answers[key]) {
                score++;
                box.classList.add('correct-answer');
            } else {
                box.classList.add('wrong-answer');
            }
        }

        // Eredmény kijelzése
        const resultDiv = document.getElementById('result');
        resultDiv.style.display = 'block';
        resultDiv.innerHTML = `Elért pontszám: ${score} / ${total} (${Math.round((score/total)*100)}%)`;
        
        if (score === total) {
            resultDiv.style.backgroundColor = '#d4edda';
            resultDiv.style.color = '#155724';
            resultDiv.innerHTML += "<br>🎉 Kiváló! Hibátlan megoldás!";
        } else if (score >= total / 2) {
            resultDiv.style.backgroundColor = '#fff3cd';
            resultDiv.style.color = '#856404';
            resultDiv.innerHTML += "<br>👍 Nem rossz, de érdemes még átnézni az elméletet!";
        } else {
            resultDiv.style.backgroundColor = '#f8d7da';
            resultDiv.style.color = '#721c24';
            resultDiv.innerHTML += "<br>📖 Olvasd át újra az összefoglalót és próbáld meg újra!";
        }
    }
</script>

</body>
</html>

